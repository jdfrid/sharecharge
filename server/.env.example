PORT=3001
DATABASE_URL=postgresql://sharecharge:sharecharge@localhost:5432/sharecharge
JWT_SECRET=change-me-in-production-use-long-random-string
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost,https://localhost

# Public URLs (Render production)
PUBLIC_API_URL=https://sharecharge.onrender.com
PUBLIC_APP_URL=https://localhost

# OTP email (production — disables demo-only console codes when configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sharecharge.app
# ALLOW_DEV_OTP=false

# Payment region default (IL | US)
DEFAULT_PAYMENT_REGION=IL
# Stripe (USA — future integration)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=

# Tranzila — real payments (from My Tranzila terminal settings)
TRANZILA_TERMINAL=your_terminal_name
TRANZILA_PW=your_terminal_password
# TRANZILA_MOCK=false
# TRANZILA_IFRAME_BASE=https://directng.tranzila.com
# TRANZILA_CGI_BASE=https://secure5.tranzila.com/cgi-bin
# TRANZILA_HANDSHAKE_URL=https://api.tranzila.com/v1/handshake/create
# TRANZILA_CURRENCY=1
